{
  "name": "dubcey-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // files uploaded to the top of the GitHub repo get copied into place before each deploy
  "build": { "command": "for f in ../*; do [ -f \"$f\" ] || continue; b=$(basename \"$f\"); case \"$b\" in *.md|*.yml|*.jsonc|*.txt|LICENSE) continue;; esac; m=$(find . -path ./node_modules -prune -o -type f -name \"$b\" -print | grep -v -e /data/cards/ -e /demo/); n=$(printf '%s' \"$m\" | grep -c .); if [ \"$n\" = 1 ]; then d=$m; else case \"$b\" in *.webp|*.png|*.jpg|*.svg) d=public/h/$b;; *.css) d=public/css/$b;; *.js) d=public/js/$b;; *.html) d=public/$b;; *.json) d=public/data/$b;; *) continue;; esac; fi; cp -f \"$f\" \"$d\" && echo \"sorted $b -> $d\"; done; true" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  // commissioner's MFL franchise number (comma-separate to add a co-commish); CLERK = who can edit the Clerk's Office notes
  "vars": { "COMMISH": "0001", "CLERK": "0005" },
  // storage for the Dispatch, team names, helmets, calendar, by-laws, finances and the suggestion box
  // deploy id, used to version scripts and styles automatically (no more ?v= bumps)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // refresh this season's lineups for History: Tuesday and Thursday mornings (11:00 UTC = 6 a.m. ET in winter)
  "triggers": { "crons": ["0 11 * * 2", "0 11 * * 4"] },
  "kv_namespaces": [{ "binding": "DC", "id": "7a954825f712428fbcb0c6e05cfae1da" }],
  "routes": [{ "pattern": "dubcey.party", "custom_domain": true }]
}
