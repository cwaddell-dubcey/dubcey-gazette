{
  "name": "dubcey-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  // commissioner's MFL franchise number (comma-separate to add a co-commish); CLERK = who can edit the Clerk's Office notes
  "vars": { "COMMISH": "0001", "CLERK": "0005" },
  // storage for the Dispatch, team names, helmets, calendar, by-laws, finances and the suggestion box
  // deploy id, used to version scripts and styles automatically (no more ?v= bumps)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "kv_namespaces": [{ "binding": "DC", "id": "7a954825f712428fbcb0c6e05cfae1da" }],
  "routes": [{ "pattern": "dubcey.party", "custom_domain": true }]
}
